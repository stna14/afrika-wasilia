# ---- App ----
ENV=development
APP_NAME="Mwafrika Asilia Backend"
API_V1_PREFIX=/api/v1

# ---- Database (MySQL) ----
# NOTE: special chars in password must be URL-encoded (# -> %23)
DATABASE_URL=mysql+aiomysql://mwafrika:CHANGE_ME@localhost:3306/mwafrika_asilia

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT ----
JWT_SECRET=CHANGE_ME_GENERATE_64_CHAR_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_64_CHAR_RANDOM
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Security ----
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT=5/10minutes

# ---- CORS (empty for now) ----
CORS_ORIGINS=
